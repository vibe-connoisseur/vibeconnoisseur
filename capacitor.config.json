{
  "appId": "com.vibeconnoisseur.wheresthevibe",
  "appName": "Where's The Vibe",
  "webDir": "www",
  "backgroundColor": "#11120f",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#11120f"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
