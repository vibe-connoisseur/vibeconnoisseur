{
  "name": "wheres-the-vibe",
  "version": "1.0.0",
  "private": true,
  "description": "Where's The Vibe: London event map, as a website and an iPhone app",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "sync:ios": "npm run build && npx cap sync ios",
    "icons": "npx @capacitor/assets generate --ios --iconBackgroundColor '#11120f' --splashBackgroundColor '#11120f'"
  },
  "dependencies": {
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3"
  }
}
